{
  "manifest_version": 3,
  "name": "ApplyPilot Copilot",
  "version": "0.1.0",
  "description": "Fills job application forms from your local ApplyPilot profile. Fills and highlights only — you always review and submit yourself. Your profile stays on this computer; AI features use a model on this computer unless you allow another.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel",
    "webNavigation",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://127.0.0.1:*/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Open the ApplyPilot Copilot panel"
    },
    "fill-page": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Fill this page with ApplyPilot"
    }
  },
  "minimum_chrome_version": "116"
}
